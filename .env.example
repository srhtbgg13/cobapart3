# Salin file ini jadi ".env" lalu isi nilai aslinya. File ".env" TIDAK
# boleh di-commit ke git (sudah ada di .gitignore) — file .env.example
# ini yang aman untuk dipublish, isinya cuma placeholder.

# Secret untuk sign JWT token login — ganti dengan string acak yang panjang,
# jangan pakai contoh di bawah ini. Bisa generate lewat:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ganti-dengan-random-string-panjang-minimal-32-karakter

# Kredensial database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=isi-password-mysql-kamu-di-sini
DB_NAME=indocement

# Origin frontend yang diizinkan akses API ini (CORS), dipisah koma,
# tanpa spasi setelah koma, tanpa trailing slash.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5000,http://localhost:5000,https://GANTI-DENGAN-USERNAME-GITHUB.github.io
